# Key for the local model endpoint. The endpoint URL itself lives in
# pi/models.json, because pi does not expand environment variables in baseUrl.
OMLX_API_KEY=replace-me

# Which model to run. Must match an `id` in pi/models.json.
OMLX_MODEL=Qwen3.6-35B-A3B-4bit

# TCP port the OpenRCT2 plugin listens on, inside the game process.
FREEPLAY_BRIDGE_PORT=8080
